# --- Coordinator bootstrap (REQUIRED — seeds the single admin account) ---
# There is no public signup; this is the only way to create the first login.
# The coordinator should change this password right after the first access.
COORDINATOR_EMAIL=coordinator@your-domain.example
COORDINATOR_PASSWORD=change_to_a_strong_password

# --- JWT ---
JWT_SECRET=change-to-a-long-random-secret-at-least-256-bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Auth cookie ---
# Marks the refresh cookie Secure — browsers only send it over HTTPS.
# false for local HTTP dev; MUST be true in production.
AUTH_COOKIE_SECURE=false

# --- CORS (backend) ---
# Dev: Vite on 5173 + compose client on 3000.
# Prod: set ONLY the frontend subdomain origin — the API lives on its own
# subdomain and the browser enforces CORS, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

# --- Client ---
VITE_API_URL=http://localhost:8080

# --- E2E tests (Playwright) — must match the seeded coordinator above ---
# E2E_ADMIN_EMAIL=coordinator@your-domain.example
# E2E_ADMIN_PASSWORD=change_to_a_strong_password
# E2E_BASE_URL=http://localhost:5173
# E2E_API_URL=http://localhost:8080
# E2E_CHANNEL=chrome          # optional: use system Chrome instead of bundled Chromium
# E2E_SLOWMO=600              # optional: ms delay per action, for watchable demo videos
