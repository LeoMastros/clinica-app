# --- Server URL ---
# Apenas a origem do servidor. O prefixo /api/v1 e montado pelo client.
VITE_API_URL=http://localhost:8080

# --- Autenticacao ---
# Minimo de 32 caracteres (HMAC SHA-256). Gere com:
#   openssl rand -base64 48
CLINICA_JWT_SEGREDO=change_to_a_strong_secret
# Duracao do token no formato ISO-8601. PT8H = 8 horas.
CLINICA_JWT_VALIDADE=PT8H

# --- Primeiro administrador ---
# Criado no boot apenas se a tabela de usuarios estiver vazia E estas duas
# estiverem preenchidas. Deixando em branco, nenhuma conta e criada — e como
# nao existe cadastro publico, ninguem consegue entrar no sistema.
CLINICA_ADMIN_INICIAL_NOME=Administrador
CLINICA_ADMIN_INICIAL_EMAIL=
CLINICA_ADMIN_INICIAL_SENHA=

# --- CORS ---
# Origens que podem chamar a API pelo navegador, separadas por virgula. Em
# producao e o endereco do front; sem isto o navegador barra a chamada, porque
# front e API ficam em subdominios diferentes.
CLINICA_CORS_ORIGENS=http://localhost:3000,http://localhost:5173
