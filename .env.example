# ============================================================
# Environment variables template. Copy to ".env" and
# fill in with real values (strong passwords, never these).
#
#   cp .env.example .env
#
# Generate a strong password in the terminal:
#   openssl rand -base64 24
# ============================================================

# --- MySQL (docker compose) ---
# WARNING: these credentials are written to the data volume on FIRST init
# only. Changing them later has no effect and crashes the backend
# (Access denied). To change them on an existing deployment you must either
# ALTER USER inside mysql or wipe the volume (docker compose down -v).
MYSQL_DATABASE=clinica_db
MYSQL_USER=clinica_user
MYSQL_PASSWORD=change_to_a_strong_password
MYSQL_ROOT_PASSWORD=change_to_a_strong_password

